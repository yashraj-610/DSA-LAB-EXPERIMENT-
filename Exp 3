
#include <iostream>
#include <string>
using namespace std;

#define MAX 5

class Queue {
private:
    string passengers[MAX];
    int front, rear;

public:
    Queue() {
        front = -1;
        rear = -1;
    }

    // Add Passenger (Enqueue)
    void enqueue(string name) {
        if (rear == MAX - 1) {
            cout << "Queue is full.\n";
            return;
        }
        if (front == -1)
            front = 0;

        passengers[++rear] = name;
        cout << name << " added to queue.\n";
    }

    // Book Ticket (Dequeue)
    void dequeue() {
        if (front == -1) {
            cout << "Queue is empty.\n";
            return;
        }

        cout << "Ticket booked for "
             << passengers[front] << endl;
        front++;

        if (front > rear) {
            front = rear = -1;
        }
    }

    // Next Passenger (Front)
    void peek() {
        if (front == -1) {
            cout << "Queue is empty.\n";
            return;
        }
        cout << "Next Passenger: "
             << passengers[front] << endl;
    }

    // Display Queue
    void display() {
        if (front == -1) {
            cout << "Queue is empty.\n";
            return;
        }

        cout << "\nPassengers in Queue:\n";
        for (int i = front; i <= rear; i++) {
            cout << passengers[i] << endl;
        }
    }
};

int main() {
    Queue q;
    int choice;
    string name;

    do {
        cout << "\n===== Ticket Booking Menu =====\n";
        cout << "1. Add Passenger (Enqueue)\n";
        cout << "2. Book Ticket (Dequeue)\n";
        cout << "3. Next Passenger (Peek)\n";
        cout << "4. Display Queue\n";
        cout << "5. Exit\n";
        cout << "Enter choice: ";
        cin >> choice;

        switch (choice) {
        case 1:
            cout << "Enter Passenger Name: ";
            cin >> ws;
            getline(cin, name);
            q.enqueue(name);
            break;

        case 2:
            q.dequeue();
            break;

        case 3:
            q.peek();
            break;

        case 4:
            q.display();
            break;

        case 5:
            cout << "Exiting...\n";
            break;

        default:
            cout << "Invalid Choice!\n";
        }
    } while (choice != 5);

    return 0;
}
